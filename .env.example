# =============================================================================
# ThaiDataCorp.com — ตัวอย่างไฟล์ตั้งค่า (คัดลอกเป็น .env.local แล้วใส่ค่าจริง)
#
#   cp .env.example .env.local
#
# .env.local ถูก .gitignore ไว้แล้ว ห้าม commit คีย์จริงขึ้น repository
# ตัวแปรที่ไม่มี prefix NEXT_PUBLIC_ จะอยู่ฝั่ง Server เท่านั้น ไม่หลุดไปที่ Browser
# =============================================================================

# URL หลักของเว็บ ใช้สร้าง Canonical URL, sitemap และ JSON-LD
NEXT_PUBLIC_SITE_URL=https://thaidatacorp.com

# -----------------------------------------------------------------------------
# GDX (Government Data Exchange) — https://api.egov.go.th
#
# วิธีขอคีย์:
#   1. สมัครหน่วยงาน/ผู้ใช้งานที่ portal ของ สพร. (DGA) และยื่นขอใช้บริการ
#      "ข้อมูลนิติบุคคล กรมพัฒนาธุรกิจการค้า (DBD)"
#   2. เมื่อได้รับอนุมัติ จะได้ Consumer-Key และ Consumer-Secret ของแอปพลิเคชัน
#   3. AGENT_ID คือเลขประจำตัวประชาชนของเจ้าหน้าที่/ผู้รับผิดชอบที่ลงทะเบียนไว้กับ GDX
#
# ถ้าเว้น GDX_CONSUMER_KEY ว่าง ระบบจะใช้ Open-D (ด้านล่าง) แทน
# ถ้าเว้นว่างทั้ง GDX_CONSUMER_KEY และ OPEND_API_KEY ระบบจะใช้ Mock Data (lib/mock-data.ts)
# และทุกหน้าจะถูกตั้ง noindex + แสดงป้าย "ข้อมูลตัวอย่าง" เพื่อไม่ให้ Google เก็บข้อมูลปลอม
# -----------------------------------------------------------------------------
GDX_CONSUMER_KEY=
GDX_CONSUMER_SECRET=
GDX_AGENT_ID=

# ค่าเริ่มต้นด้านล่างนี้ใช้ได้เลย แก้เฉพาะเมื่อ GDX แจ้ง path/version ใหม่ในหน้าเอกสารบริการ
# GDX_BASE_URL=https://api.egov.go.th
# GDX_AUTH_PATH=/ws/auth/validate
# GDX_DBD_PROFILE_PATH=/ws/dbd/juristic/v4/profile

# -----------------------------------------------------------------------------
# Open-D (opend.data.go.th) — ข้อมูลเปิด DBD บน data.go.th
#
# วิธีขอคีย์: สมัคร/ล็อกอินที่ https://opend.data.go.th → หน้า "สถิติการใช้งาน"
# คัดลอกค่าในช่อง USER TOKEN มาใส่ด้านล่าง (ส่งผ่าน header "api-key")
#
# ใช้เมื่อไม่ได้ตั้ง GDX_CONSUMER_KEY — ครอบคลุมนิติบุคคลที่จดทะเบียนตั้งใหม่/เลิก ตั้งแต่ ม.ค. 2565
# ไม่มีชื่อภาษาอังกฤษ กรรมการ ผู้ถือหุ้น และงบการเงิน
# -----------------------------------------------------------------------------
OPEND_API_KEY=

# ค่าเริ่มต้น (แก้เฉพาะเมื่อ data.go.th เปลี่ยน dataset id)
# OPEND_BASE_URL=https://data.go.th/api/3/action
# OPEND_NEW_DATASET=dataset_11_0121
# OPEND_DISSOLVED_DATASET=dataset_11_0219

# -----------------------------------------------------------------------------
# MySQL / MariaDB — เก็บข้อมูล Open-D ที่ sync มา (แนะนำสำหรับ Production)
#
# เมื่อตั้งค่าแล้ว เว็บจะอ่านจาก DB แทนการเรียก Open-D API ตรง
#   npm run db:migrate   # สร้างตาราง (ครั้งแรก)
#   npm run sync         # ดึงข้อมูล (ตั้ง Scheduled Task ให้รันวันละครั้ง)
#
# ถ้า Next.js รันบนเครื่องเดียวกับ DB (Plesk) ใช้ DB_HOST=localhost
# รหัสผ่านที่มีอักขระพิเศษ (* ? # $) ให้ครอบด้วยเครื่องหมายคำพูด
# -----------------------------------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=""
# DB_POOL_SIZE=10

# -----------------------------------------------------------------------------
# (ไม่บังคับ) แหล่งข้อมูลกรรมการ/ผู้ถือหุ้น และงบการเงิน
# บริการ Profile ของ GDX ไม่ส่งข้อมูลส่วนนี้มา ให้ชี้ไปยัง API ภายในของคุณ
# (เช่น ETL จาก DBD DataWarehouse) โดยใช้ {id} แทนเลขทะเบียน 13 หลัก
# รูปแบบ JSON ที่ต้องคืนค่า: ดู DirectorsApiResponse / FinancialsApiResponse ใน types/company.ts
# -----------------------------------------------------------------------------
# DIRECTORS_API_URL=https://internal.thaidatacorp.com/api/juristic/{id}/directors
# FINANCIALS_API_URL=https://internal.thaidatacorp.com/api/juristic/{id}/financials
# INTERNAL_API_TOKEN=

# -----------------------------------------------------------------------------
# ระบบสมาชิก / ชำระเงิน / อีเมล
# -----------------------------------------------------------------------------
# อีเมลผู้ดูแล (เข้าหน้า /admin เพื่อยืนยันการชำระเงิน) คั่นด้วย ,
ADMIN_EMAILS=
# PromptPay ที่รับเงิน: เบอร์มือถือ 10 หลัก หรือเลขนิติบุคคล/ผู้เสียภาษี 13 หลัก
PROMPTPAY_ID=
PROMPTPAY_NAME=
# SMTP (เช่น เมลของ Plesk) สำหรับอีเมลแจ้งเตือน (ไม่เกี่ยวกับการเข้าสู่ระบบ)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=""
MAIL_FROM="ThaiDataCorp <no-reply@thaidatacorp.com>"
# ใช้ Gmail: MAIL_FROM ต้องเป็นอีเมล Gmail นั้น แล้วตั้ง MAIL_REPLY_TO=info@thaidatacorp.com ให้การตอบกลับไปที่ info@
MAIL_REPLY_TO=

# -----------------------------------------------------------------------------
# เข้าสู่ระบบด้วย Google (ไม่บังคับ — ว่าง = ซ่อนปุ่ม Google)
#   console.cloud.google.com → APIs & Services → Credentials → Create OAuth client ID → Web application
#   Authorized redirect URIs: https://thaidatacorp.com/auth/google/callback
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Cloudflare R2 — เก็บรูปที่ผู้ใช้อัปโหลด (โลโก้/รูปข่าว) + สำเนาไฟล์สำรองข้อมูลรายวัน
# ว่าง = เก็บในเครื่อง (storage/)
# -----------------------------------------------------------------------------
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=thaidatacorp
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ใช้กับ Plesk Scheduled Task แบบ Fetch a URL: /api/cron/tick?key=<CRON_SECRET> (ยาวอย่างน้อย 16 ตัว)
CRON_SECRET=
